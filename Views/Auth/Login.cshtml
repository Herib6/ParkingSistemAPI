<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ParkingPro</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-wrapper {
            width: 100%;
            min-height: 100vh;
            display: flex;
        }

        .login-left {
            flex: 1;
            background: linear-gradient(135deg, #8B2E2E 0%, #A63D3D 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            padding: 40px 20px;
        }

        .logo-section {
            text-align: center;
            margin-bottom: 50px;
        }

        .logo-icon {
            font-size: 80px;
            margin-bottom: 20px;
        }

        .logo-section h1 {
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }

        .logo-section p {
            font-size: 18px;
            font-weight: 300;
            opacity: 0.9;
        }

        .features {
            margin-top: 60px;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .feature {
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }

        .feature-icon {
            font-size: 32px;
            flex-shrink: 0;
        }

        .feature-text h3 {
            font-size: 18px;
            margin-bottom: 5px;
        }

        .feature-text p {
            font-size: 14px;
            opacity: 0.85;
        }

        .login-right {
            flex: 1;
            background: white;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }

        .login-form {
            width: 100%;
            max-width: 400px;
        }

        .form-title {
            text-align: center;
            margin-bottom: 10px;
        }

        .form-title h2 {
            font-size: 32px;
            color: #333;
            margin-bottom: 5px;
        }

        .form-title p {
            color: #999;
            font-size: 14px;
        }

        .error-message {
            background-color: #fee;
            color: #c33;
            padding: 12px;
            border-radius: 5px;
            margin-bottom: 20px;
            border-left: 4px solid #c33;
        }

        .success-message {
            background-color: #efe;
            color: #3c3;
            padding: 12px;
            border-radius: 5px;
            margin-bottom: 20px;
            border-left: 4px solid #3c3;
        }

        .form-group {
            margin-bottom: 25px;
            margin-top: 30px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 600;
            font-size: 14px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 5px;
            font-size: 14px;
            transition: all 0.3s;
            font-family: inherit;
        }

        .form-group input:focus {
            outline: none;
            border-color: #8B2E2E;
            box-shadow: 0 0 0 3px rgba(139, 46, 46, 0.1);
        }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #8B2E2E 0%, #A63D3D 100%);
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 20px;
            transition: all 0.3s;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(139, 46, 46, 0.3);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .form-footer {
            text-align: center;
            margin-top: 20px;
            color: #666;
            font-size: 14px;
        }

        .form-footer a {
            color: #8B2E2E;
            text-decoration: none;
            font-weight: 600;
            margin-left: 5px;
        }

        .form-footer a:hover {
            text-decoration: underline;
        }

        @@media (max-width: 768px) {
            .login-wrapper {
                flex-direction: column;
            }

            .login-left {
                min-height: 200px;
                padding: 30px 20px;
            }

            .logo-section {
                margin-bottom: 30px;
            }

            .logo-section h1 {
                font-size: 36px;
            }

            .features {
                margin-top: 20px;
                gap: 20px;
            }

            .login-right {
                min-height: auto;
                padding: 30px 20px;
            }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-left">
            <div class="logo-section">
                <div class="logo-icon"><i class="fas fa-car"></i></div>
                <h1>PARKINGPRO</h1>
                <p>Sistema de Gestión de Estacionamiento</p>
            </div>
            <div class="features">
                <div class="feature">
                    <div class="feature-icon"><i class="fas fa-map-pin"></i></div>
                    <div class="feature-text">
                        <h3>Gestión Completa</h3>
                        <p>Controla entrada y salida de vehículos automáticamente</p>
                    </div>
                </div>
                <div class="feature">
                    <div class="feature-icon"><i class="fas fa-credit-card"></i></div>
                    <div class="feature-text">
                        <h3>Cálculo de Tarifas</h3>
                        <p>Tarificación automática según tiempo de estancia</p>
                    </div>
                </div>
                <div class="feature">
                    <div class="feature-icon"><i class="fas fa-chart-bar"></i></div>
                    <div class="feature-text">
                        <h3>Reportes Detallados</h3>
                        <p>Visualiza movimientos e ingresos en tiempo real</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="login-right">
            <div class="login-form">
                <div class="form-title">
                    <h2>Bienvenido</h2>
                    <p>Inicia sesión en tu cuenta</p>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="error-message">@ViewBag.Error</div>
                }

                @if (!string.IsNullOrEmpty(ViewBag.Success))
                {
                    <div class="success-message">@ViewBag.Success</div>
                }

                <form method="post" action="@Url.Action("Login", "Auth")">
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="tu@email.com" value="@ViewBag.Email" required>
                    </div>

                    <div class="form-group">
                        <label for="contrasena">Contraseña</label>
                        <input type="password" id="contrasena" name="contrasena" placeholder="••••••••" required>
                    </div>

                    @if (ViewBag.MostrarCodigoVerificacion == true)
                    {
                        <div style="background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 12px; border-radius: 5px; margin-bottom: 20px; font-size: 13px; color: #856404;">
                            <strong>⚠️ Este email aún no está verificado.</strong> Por favor, ingresa el código de verificación que recibiste en tu correo.
                        </div>

                        <div class="form-group">
                            <label for="codigoVerificacion">Código de Verificación</label>
                            <input type="text" id="codigoVerificacion" name="codigoVerificacion" 
                                   placeholder="Ingresa el código de 6 dígitos" 
                                   maxlength="6" inputmode="numeric" required>
                            <small style="color: #999; display: block; margin-top: 5px;">
                                📧 Revisa tu correo (incluida la carpeta de spam)
                            </small>
                        </div>

                        <button type="submit" class="btn-login">Verificar y Continuar</button>

                        <div style="text-align: center; margin-top: 15px;">
                            <small>
                                <a href="#" onclick="reenviarCodigo('@ViewBag.Email'); return false;" style="color: #8B2E2E; text-decoration: none; font-weight: 500;">
                                    ¿No recibiste el código? Reenviar
                                </a>
                            </small>
                        </div>
                    }
                    else
                    {
                        <button type="submit" class="btn-login">Iniciar Sesión</button>
                    }
                </form>

                <div class="form-footer">
                    ¿No tienes cuenta?
                    <a href="@Url.Action("Register", "Auth")">Regístrate aquí</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function reenviarCodigo(email) {
            if (!email) {
                alert('Error: Email no disponible');
                return;
            }

            fetch('@Url.Action("ReenviarCodigo", "Auth")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'email=' + encodeURIComponent(email)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error al reenviar código');
            });
        }
    </script>
</body>
</html>


